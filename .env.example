# Copy to .env, fill in, and load before running: set -a; . ./.env; set +a

# Required roots.
DATA_ROOT=/path/to/data
OUTPUT_ROOT=/path/to/outputs
MODELS_ROOT=/path/to/models
HF_HOME=/path/to/hf_cache

# Required by experiments/surgvu/create_dataset.py: the raw SurgVU label files.
SURGVU_LABELS_DIR=/path/to/surgvu/labels

# Required by the SDSC-EEA scripts: the JSON file that maps label class ids
# to tool names. It comes with the dataset.
SDSC_EEA_CLASS_MAPPING=/path/to/sdsc_eea/class_mapping.json

# Optional overrides of the public dataset locations under DATA_ROOT/public.
CHOLECT50_ROOT=
PITVIS_ROOT=
SURGVU_ROOT=

# Optional: the PitVis-2023 root recorded in dataset.csv frame paths, when the
# frames have moved since the table was written.
PITVIS_RECORDED_ROOT=

# Secrets. Never commit real values.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
HF_TOKEN=
